{
  "expo": {
    "name": "Stampd",
    "slug": "stampd-bahamas",
    "scheme": "stampd",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00605A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stampdbahamas.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00605A"
      },
      "package": "com.stampdbahamas.app",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#00605A"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00605A"
        }
      ],
      "@sentry/react-native",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.260743851123-sntceefkh14d5l7gnbupf42m66hi3lr7"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4f837e94-3fd7-400d-927c-52029ddbc8e5"
      },
      "router": {}
    },
    "owner": "jayrkyd"
  }
}
